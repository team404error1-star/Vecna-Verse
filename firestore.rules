rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if isOwner(userId);

      // User Saved Events Subcollection
      match /saved/{savedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(eventId);
      allow update: if isSignedIn() && isValidId(eventId);
      allow delete: if isSignedIn() && isValidId(eventId);
    }

    // Registrations Collection
    match /registrations/{registrationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(registrationId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(registrationId);
      allow delete: if isSignedIn() && isValidId(registrationId);
    }
  }
}
