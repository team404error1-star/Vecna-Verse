# -------------------------------------------------------------
# LOCORA REAL INTEGRATIONS & API KEYS CONFIGURATION
# -------------------------------------------------------------

# 1. GEMINI_API_KEY (Recommended for Live Google Search Event Discovery)
# What it does: Powers real-time event discovery and Google Search Grounding to extract
# real, scheduled upcoming events, venues, and dates in any city worldwide.
# Where to paste: In Google AI Studio, open the "Secrets" panel (key icon in left sidebar)
# and set GEMINI_API_KEY. For local development, set it in your local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. TICKETMASTER_API_KEY (Optional for Official Live Ticketmaster Events)
# What it does: Fetches millions of real live concerts, theater, sports, and arts events.
# Where to get: Free instantly at https://developer.ticketmaster.com/
# Where to paste: In your .env file or the AI Studio Secrets panel.
TICKETMASTER_API_KEY=""

# 3. APP_URL
# Automatically injected by AI Studio at runtime.
APP_URL="MY_APP_URL"

# 4. FRONTEND API ROUTING
# VITE_API_BASE_URL: Base URL for backend endpoints (default: /api)
VITE_API_BASE_URL="/api"

# VITE_USE_MOCK_API: Set to "false" to use the real full-stack backend server.
# Set to "true" only if you want to bypass the server.
VITE_USE_MOCK_API="false"
